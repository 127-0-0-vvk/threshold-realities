# Console credentials. Copy to .env.local and set your own values.
# ADMIN_PASSWORD  the password typed into the console sign-in
# ADMIN_SECRET    used to sign the session cookie; any long random string
ADMIN_PASSWORD=change-me
ADMIN_SECRET=generate-with-openssl-rand-hex-32

# Supabase — the production store for console posts and images.
# Dashboard -> Project Settings -> API
# SUPABASE_URL is the Project URL.
# SUPABASE_SERVICE_ROLE_KEY is the service_role secret. Server-side only —
# it bypasses row-level security, so it must never be exposed to the browser
# and must never be prefixed NEXT_PUBLIC_.
SUPABASE_URL=https://ochaxavfzvwyfveuleto.supabase.co
