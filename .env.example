# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored. THIS file is tracked and public — never put a real
# secret in it.

# Console sign-in
ADMIN_PASSWORD=change-me
ADMIN_SECRET=generate-with-openssl-rand-hex-32

# Supabase — the store for console posts and images.
# Dashboard -> Project Settings -> API Keys
# The secret key bypasses row-level security. Server-side only: never put it in
# this file, never prefix it NEXT_PUBLIC_.
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-secret-key
